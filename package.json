{
  "name": "@0xkahi/pi-arsenal",
  "version": "0.2.1",
  "description": "pi arsenal of useful tools",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tools"
  ],
  "author": "0xKahi",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "index.ts",
    "prompts",
    "assets/config.schema.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xKahi/pi-arsenal.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "biome": "biome check ./src ./index.ts",
    "lint": "bun biome",
    "lint:fix": "bun biome --write",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint:fix && bun run type-check",
    "release": "changeset publish",
    "version": "changeset version",
    "changeset": "changeset",
    "buildSchema": "bun run scripts/build-schema.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "bun-types": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "@0xkahi/cli-dye": "^1.1.0",
    "typebox": "^1.3.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.1",
    "zod": "^4.4.3"
  }
}
