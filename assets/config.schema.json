{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/0xKahi/pi-arsenal/main/assets/config.schema.json",
  "title": "Pi Arsenal Extension Configuration",
  "description": "Configuration schema for the pi-arsenal extension",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tmux_popup": {
      "default": {
        "enabled": false,
        "width": 50,
        "height": 50,
        "fileCommand": "nvim"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "width": {
          "default": 50,
          "type": "number",
          "minimum": 10,
          "maximum": 100
        },
        "height": {
          "default": 50,
          "type": "number",
          "minimum": 10,
          "maximum": 100
        },
        "fileCommand": {
          "default": "nvim",
          "type": "string"
        }
      }
    },
    "p2p_council": {
      "default": {
        "enabled": false,
        "layout": "inline"
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "layout": {
          "default": "inline",
          "type": "string",
          "enum": [
            "inline",
            "overlay"
          ]
        }
      }
    },
    "multiverse": {
      "default": {
        "enabled": false,
        "defaultAgent": "default",
        "maxConcurrency": 5,
        "subagents": {
          "explorer": {
            "enabled": true
          },
          "fixer": {
            "enabled": true
          },
          "visualizer": {
            "enabled": true
          }
        }
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Enable Multiverse orchestration and child persona/tool behavior.",
          "type": "boolean"
        },
        "defaultAgent": {
          "default": "default",
          "description": "Initial parent persona when no saved selection exists.",
          "type": "string",
          "enum": [
            "default",
            "megamind"
          ]
        },
        "maxConcurrency": {
          "default": 5,
          "description": "Maximum child interactions running concurrently in one batch.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "defaultPreset": {
          "description": "Initial named model preset when it exists; missing or unknown names use the built-in default.",
          "type": "string"
        },
        "presets": {
          "description": "Named model lineup overrides by preset and agent. Entries may omit fields to inherit subagent and parent-session values.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "provider": {
                  "description": "Optional provider override; omitted values inherit from the subagent model or parent session.",
                  "type": "string"
                },
                "modelId": {
                  "description": "Optional model ID override; omitted values inherit from the subagent model or parent session.",
                  "type": "string"
                },
                "reasoning": {
                  "description": "Optional requested reasoning override; omitted values inherit from the subagent model or parent session.",
                  "type": "string",
                  "enum": [
                    "off",
                    "minimal",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "subagents": {
          "default": {
            "explorer": {
              "enabled": true
            },
            "fixer": {
              "enabled": true
            },
            "visualizer": {
              "enabled": true
            }
          },
          "description": "Settings by registered subagent name; unspecified agents default to enabled. Settings alone do not register agents.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "default": true,
                "description": "Whether this registered subagent can be created or continued.",
                "type": "boolean"
              },
              "model": {
                "description": "Optional preferred model; the parent model is used when omitted.",
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string"
                  },
                  "modelId": {
                    "type": "string"
                  },
                  "reasoning": {
                    "type": "string",
                    "enum": [
                      "off",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}